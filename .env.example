# Провайдер: polza.ai (оплат в рублях, OpenAI-совместимый API)
# Основная модель (Писатель, Планировщик, Фильтр надёжности, Верификатор)
LLM_API_KEY=ключ_polza_из_личного_кабинета
LLM_BASE_URL=https://polza.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Независимая модель-судья для eval_benchmark.py
# ВАЖНО: другое семейство (Meta), НЕ должна совпадать с LLM_MODEL
JUDGE_API_KEY=ключ_polza_из_личного_кабинета
JUDGE_BASE_URL=https://polza.ai/api/v1
JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAlex: базовый API бесплатен и работает без ключа, достаточно почты в OPENALEX_MAILTO
OPENALEX_API_KEY=
OPENALEX_MAILTO=student@university.edu

# Язык обзора (English нужен для точного поиска совпадений слов в PDF)
REVIEW_LANG=English

# Паузы между запросами в секундах (лимит шлюза 1 запрос/сек)
LLM_SLEEP=1
JUDGE_SLEEP=1
