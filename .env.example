# Основная модель (Писатель, Планировщик, Фильтр надёжности)
LLM_API_KEY=ваш_ключ_openrouter_или_groq
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Независимая модель-судья для eval_benchmark.py (ДОЛЖНА отличаться от LLM_MODEL!)
JUDGE_API_KEY=ваш_ключ_openrouter_или_groq
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenAlex: базовый API бесплатен и работает без ключа, достаточно почты в OPENALEX_MAILTO
# (ключ OPENALEX_API_KEY необязателен, есть только у премиум-аккаунтов)
OPENALEX_API_KEY=
OPENALEX_MAILTO=student@university.edu

# Язык обзора (English нужен для точного поиска совпадений слов в PDF)
REVIEW_LANG=English

# Пауза между запросами в секундах (если бесплатный API выдает ошибку 429)
LLM_SLEEP=1
JUDGE_SLEEP=1